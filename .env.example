# Free token: https://huggingface.co/settings/tokens (enable "Inference Providers")
HF_TOKEN=hf_xxx
# Any tool-calling chat model on HF, e.g.:
# HF_MODEL=meta-llama/Llama-3.3-70B-Instruct
# HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HF_MODEL=Qwen/Qwen2.5-72B-Instruct
HITL_ENABLED=true
MAX_MODEL_CALLS_PER_RUN=15
